[Unit]
Description=Ночная резервная копия трекера

[Timer]
# Ночью, когда никто не работает. Разброс в 10 минут — чтобы копия не
# начиналась ровно в один момент с чужими ночными задачами на машине.
OnCalendar=*-*-* 04:20:00
RandomizedDelaySec=10m
# Машину выключают редко, но если пропустили — снять при первой
# возможности, а не ждать следующей ночи.
Persistent=true

[Install]
WantedBy=timers.target
